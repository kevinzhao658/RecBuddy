# PROD Supabase credentials for `npm run seed:review` (App Store reviewer demo account).
# This MUST be the SAME project the iOS Release/"RecBuddy Prod" build talks to
# (Config.prod.xcconfig → dclxyvtxwibtilnatyqp.supabase.co) — otherwise the demo
# account won't exist for the reviewer.
# Copy to .env.prod and fill from your Supabase dashboard → Project Settings → API.
# .env.prod is gitignored. The service_role key is SECRET — never commit it.
SUPABASE_URL=https://dclxyvtxwibtilnatyqp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<prod-service_role-secret-key>

# Optional: override the demo password (defaults to RecBuddy-Review-2026! in the script).
# REVIEW_PASSWORD=<choose-a-strong-password>
