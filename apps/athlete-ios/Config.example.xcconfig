// Copy to Config.xcconfig (gitignored) and fill in. Values from Supabase
// dashboard -> Project Settings -> API. Dev project: bawezljwxehadmkjeydw.
// NOTE: '//' starts a comment in xcconfig — write URLs as https:/$()/host.
SUPABASE_URL = https:/$()/bawezljwxehadmkjeydw.supabase.co
SUPABASE_ANON_KEY = <dev-anon-key>
// Where the forgot-password email lands. MUST be a web app whose Supabase
// client points at the SAME project as this build (dev -> local web app).
RESET_PASSWORD_REDIRECT = http:/$()/localhost:5176/reset-password
// Where the signup confirmation email lands. MUST be a web app whose Supabase
// client points at the SAME project as this build (dev -> local web app).
EMAIL_CONFIRM_REDIRECT = http:/$()/localhost:5176/confirmed
