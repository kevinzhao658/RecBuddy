// Template for the two build configs (both gitignored):
//   cp Config.example.xcconfig Config.dev.xcconfig   # Debug  / Simulator / dev Supabase
//   cp Config.example.xcconfig Config.prod.xcconfig  # Release / iPhone    / prod Supabase
// Fill each from its Supabase project dashboard -> Project Settings -> API.
// Dev project ref: bawezljwxehadmkjeydw. Prod: your separate prod project.
// NOTE: '//' starts a comment in xcconfig — write URLs as https:/$()/host.
SUPABASE_URL = https:/$()/<project-ref>.supabase.co
SUPABASE_ANON_KEY = <anon-public-key>
// Where the forgot-password / signup emails land. MUST be a web app whose
// Supabase client points at the SAME project as this build:
//   dev  -> http:/$()/localhost:5176   prod -> your Vercel prod domain
RESET_PASSWORD_REDIRECT = https:/$()/<web-host>/reset-password
EMAIL_CONFIRM_REDIRECT = https:/$()/<web-host>/confirmed
